# Copy to .env.local (git-ignored) for local development.
# Last.fm API key: https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=
# YouTube Data API v3 key, used when the walkman sends a full song to the TV.
# Optional: without it the /api/youtube proxy is used (YOUTUBE_API_KEY on Vercel).
VITE_YOUTUBE_API_KEY=
# Public address of the site, for the link-preview tags in index.html
# (on Vercel the production domain is used when this is empty).
VITE_SITE_URL=
# Where the /api functions live when running the frontend on its own
# (leave empty when the site and the API share a domain).
VITE_API_BASE=https://drack112-ten.vercel.app
