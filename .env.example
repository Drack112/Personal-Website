LASTFM_API_KEY=
LASTFM_USER=
# YouTube Data API v3 key, for sending a full song from the walkman to the TV.
YOUTUBE_API_KEY=
# Public address of the site, for the link-preview tags in index.html
# (on Vercel the production domain is used when this is empty).
VITE_SITE_URL=
# Optional, `npm run dev` only: where to send /api (defaults to the production site).
API_PROXY=
