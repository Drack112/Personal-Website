# On Vercel, set these in Project Settings -> Environment Variables.
# Locally they are only needed for `npx vercel dev` (copy this file to .env):
# `npm run dev` uses the deployed API instead. The browser never sees them.
# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Optional: whose scrobbles to show (defaults to Drack112).
LASTFM_USER=
# YouTube Data API v3 key, for sending a full song from the walkman to the TV.
YOUTUBE_API_KEY=
# Public address of the site, for the link-preview tags in index.html
# (on Vercel the production domain is used when this is empty).
VITE_SITE_URL=
# Optional, `npm run dev` only: where to send /api (defaults to the production site).
API_PROXY=
